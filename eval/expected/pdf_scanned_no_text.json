{
  "file": "pdf_scanned_no_text.pdf",
  "format": "pdf",
  "test_focus": "扫描件（无文字层）必须明确报错",
  "expected": {
    "should_raise": true,
    "error_code": "no_text_layer",
    "page_count": 1,
    "extractable_chars_per_page": 0
  },
  "assertions": [
    "解析抛出 ParseError，code == 'no_text_layer'",
    "错误信息提示不支持 OCR",
    "不得返回空 ParsedDoc 并标记成功"
  ]
}