{
  "file": "txt_gbk_chinese.txt",
  "format": "txt",
  "test_focus": "GBK 编码识别",
  "expected": {
    "encoding": "gbk",
    "line_count": 14,
    "sections": [
      "一、差旅管理",
      "二、采购管理",
      "三、用印管理"
    ],
    "key_facts": {
      "一线城市住宿上限": "480 元",
      "出差补贴": "120 元",
      "采购审批阈值_副总": "5 万元",
      "采购审批阈值_总经理": "20 万元"
    }
  },
  "assertions": [
    "解析出的第一个字符是 '青'，不是乱码",
    "文本包含 '480 元' 与 '20 万元'",
    "不得因编码错误产生替换字符 U+FFFD"
  ]
}