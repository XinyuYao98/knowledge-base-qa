# ============================================================================
# RAG 知识库问答系统 — 环境变量模板
# ----------------------------------------------------------------------------
# 使用方法：cp .env.example .env，然后按需修改
# 所有值都有默认，仅 JWT_SECRET / FERNET_KEY 在非开发环境必须自定义
# ============================================================================

# ---------- 基础 ----------
APP_ENV=dev                      # dev | staging | prod
LOG_LEVEL=INFO
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000

# ---------- 数据库 ----------
# 注意：必须使用非 superuser 账号，否则 RLS 会被绕过
# 首次初始化时，DATABASE_ADMIN_URL 用于建库建表，之后业务只用 DATABASE_URL
# 端口默认 5433（dev 编排把容器 5432 映射到宿主机 5433，避免与本机已有 PG 冲突）
# 若你的 5433 也占用，改 docker-compose.dev.yml 的 POSTGRES_PORT 并同步这里
DATABASE_URL=postgresql+psycopg://kbapp:CHANGE_ME@127.0.0.1:5433/kbqa
DATABASE_ADMIN_URL=postgresql://postgres:CHANGE_ME@127.0.0.1:5433/kbqa

# ---------- Redis ----------
# 端口默认 6380（同上，避开本机可能已占用的 6379）
REDIS_URL=redis://127.0.0.1:6380/0

# ---------- Chroma ----------
# 两种模式：embedded（进程内，单机最简）/ http（独立服务，可多进程共享）
CHROMA_MODE=embedded             # embedded | http
CHROMA_HOST=127.0.0.1
CHROMA_PORT=8000
CHROMA_PATH=./data/chroma

# ---------- 容器端口（供 docker compose 使用）----------
POSTGRES_PORT=5433
REDIS_PORT=6380

# ---------- 文件存储 ----------
# 本地卷（本项目默认）。若改用 S3 兼容存储，见 docs/knowledge/技术说明.md
STORAGE_ROOT=./data

# ---------- 安全 ----------
# 生成方式：python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-change-me-in-production-please
JWT_ALG=HS256
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800

# 模型密钥加密（Fernet，32 字节 base64）
# 生成方式：python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
FERNET_KEY=

# ---------- Embedding 服务（本地） ----------
# 开发：LM Studio 加载 Qwen3-Embedding-4B-Q4_K_M，开启本地服务（默认端口 1234）
# 契约：只认这三个值，底层是 LM Studio / llama-cpp-python / vLLM 都能接
EMBED_BASE_URL=http://127.0.0.1:1234/v1
EMBED_API_KEY=lm-studio
EMBED_MODEL=qwen3-embedding-4b
# 必须与库中已有向量一致；换值后须执行 make reindex
EMBED_DIM=2560
# 是否在请求体传 dimensions（需服务端支持 MRL；LM Studio 通常不支持，保持 false）
EMBED_SEND_DIMENSIONS=false
EMBED_BATCH_SIZE=16
EMBED_TIMEOUT_SECONDS=60

# ---------- Reranker 服务（本地） ----------
RERANK_ENABLED=true
RERANK_BASE_URL=http://127.0.0.1:1234/v1
RERANK_MODEL=qwen3-reranker-0.6b
RERANK_TIMEOUT_SECONDS=5
RERANK_TOP_N=5

# ---------- 检索参数 ----------
RRF_K=60
RETRIEVE_VECTOR_TOP_K=20
RETRIEVE_BM25_TOP_K=20
RETRIEVE_FINAL_TOP_K=5
RETRIEVE_MIN_SCORE=0.15
RETRIEVAL_TIMEOUT_SECONDS=5

# ---------- 切块参数 ----------
CHUNK_TARGET_TOKENS=400
CHUNK_OVERLAP_TOKENS=60
PARENT_TARGET_TOKENS=1500
MIN_CHUNK_CHARS=20

# ---------- 生成参数 ----------
CHAT_CONTEXT_MAX_TOKENS=6000
CHAT_MAX_OUTPUT_TOKENS=1200
CHAT_TEMPERATURE=0.2
CHAT_FIRST_TOKEN_TIMEOUT_SECONDS=20
CHAT_TOTAL_TIMEOUT_SECONDS=120
CHAT_MAX_QUESTION_CHARS=4000
CHAT_HISTORY_TURNS=6
MAX_REPAIR_ATTEMPTS=1

# ---------- 配额（产品规则，写死不做后台） ----------
MAX_KB_PER_USER=5
KB_QUOTA_BYTES=1073741824
MAX_SINGLE_FILE_BYTES=209715200
MAX_FILES_PER_KB=1000
DAILY_ASK_LIMIT=200
MAX_CONCURRENT_ASK=3
MAX_CONCURRENT_INGEST=2

# ---------- 限流 ----------
RATE_ASK_PER_MINUTE=20
RATE_UPLOAD_INIT_PER_HOUR=60
RATE_LOGIN_PER_MINUTE=5

# ---------- 数据保留 ----------
STAGING_RETENTION_DAYS=7
UPLOAD_PART_RETENTION_HOURS=24
